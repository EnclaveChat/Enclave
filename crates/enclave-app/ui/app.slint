// Enclave app window. Point of view (docs/17-design.md): private
// correspondence done well: warm paper, deep pine ink, and one saffron seal
// that appears only when something has really been confirmed.
import "fonts/AtkinsonHyperlegibleNext-Regular.ttf";
import "fonts/AtkinsonHyperlegibleNext-SemiBold.ttf";
import "fonts/AtkinsonHyperlegibleMono-Regular.ttf";
// Emoji (reactions, and emoji people type): Noto Emoji, monochrome outlines.
import "fonts/NotoEmoji-Regular.ttf";
import { Tokens } from "tokens.slint";
import {
    Body, Secondary, Caption, Title, ScreenTitle, Code, Seal, SealState, PrimaryButton,
    QuietButton, ActionTile, Field, Avatar, Notice, Icons,
} from "controls.slint";

export { Tokens }

// 0 = waiting for them, 1 = request to us, 2 = talking.
export struct ContactRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    preview: string,
    time: string,
    unread: int,
    state: int,
    verified: bool,
    met: bool,
    // 0 person, 1 group
    kind: int,
    members: int,
}

export struct PickRow {
    id: string,
    name: string,
    initials: string,
    tint: color,
    selected: bool,
}

export struct DeviceRow {
    id: string,
    label: string,
    detail: string,
    removable: bool,
    history-pending: bool,
}

// status: 0 sending privately, 1 on its way, 2 delivered.
export struct MessageRow {
    text: string,
    outgoing: bool,
    time: string,
    status: int,
    sender: string,
    // Position in the conversation (decimal), for actions on it.
    seq: string,
    can-edit: bool,
    deleted: bool,
    file: string,
    // A picture: its preview comes separately (decoded by mediad).
    picture: bool,
    has-image: bool,
    image: image,
}

export enum Screen { welcome, name, setting-up, join, locked, main }
export enum Sheet { none, my-code, add, check-code, settings, recovery, new-group, devices, meet, timer, attach, members }

component DeliveryMark inherits Rectangle {
    in property <int> status;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    border-width: 1.5px;
    border-color: Tokens.meta-on-bubble-out;
    background: root.status >= 2 ? Tokens.meta-on-bubble-out : transparent;
    accessible-role: image;
    accessible-label: root.status == 0 ? "Sending privately" : root.status == 1 ? "On its way" : "Read";
    if root.status == 1: Rectangle {
        x: 0;
        width: parent.width / 2;
        border-top-left-radius: 5px;
        border-bottom-left-radius: 5px;
        background: Tokens.meta-on-bubble-out;
    }
}

component Bubble inherits HorizontalLayout {
    in property <MessageRow> msg;
    in property <length> bubble-max;
    in property <bool> selected;
    callback tapped();
    alignment: root.msg.outgoing ? end : start;
    Rectangle {
        max-width: root.bubble-max;
        background: root.msg.outgoing ? Tokens.bubble-out : Tokens.bubble-in;
        border-width: root.selected ? 2px : 0px;
        border-color: Tokens.focus-ring;
        TouchArea { clicked => { root.tapped(); } }
        border-top-left-radius: Tokens.radius-bubble;
        border-top-right-radius: Tokens.radius-bubble;
        border-bottom-left-radius: root.msg.outgoing ? Tokens.radius-bubble : Tokens.radius-bubble-tail;
        border-bottom-right-radius: root.msg.outgoing ? Tokens.radius-bubble-tail : Tokens.radius-bubble;
        accessible-role: text;
        accessible-label: (root.msg.outgoing ? "You: " : "") + (root.msg.picture ? "Photo: " + root.msg.file + ". " : "") + root.msg.text + ", " + root.msg.time;
        accessible-action-default => { root.tapped(); }
        VerticalLayout {
            padding-left: Tokens.space-sm;
            padding-right: Tokens.space-sm;
            padding-top: Tokens.space-s;
            padding-bottom: Tokens.space-s;
            spacing: Tokens.space-xs;
            if !root.msg.outgoing && root.msg.sender != "": Text {
                text: root.msg.sender;
                font-size: Tokens.type-caption;
                font-weight: 600;
                color: Tokens.pine;
            }
            if root.msg.has-image: Rectangle {
                // Natural size, narrowed to the bubble, aspect kept.
                width: min(root.bubble-max - 2 * Tokens.space-sm, root.msg.image.width * 1px);
                height: self.width * root.msg.image.height / max(1, root.msg.image.width);
                border-radius: Tokens.radius-control;
                clip: true;
                Image {
                    source: root.msg.image;
                    width: parent.width;
                    height: parent.height;
                    image-fit: fill;
                    accessible-role: image;
                    accessible-label: "Picture: " + root.msg.file;
                }
            }
            if root.msg.picture && !root.msg.has-image: Text {
                text: "Photo: " + root.msg.file;
                font-size: Tokens.type-body;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            if root.msg.text != "": Text {
                text: root.msg.text;
                font-size: Tokens.type-body;
                color: root.msg.outgoing ? Tokens.on-bubble-out : Tokens.text;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-xs;
                Text {
                    text: root.msg.time;
                    font-size: Tokens.type-caption;
                    color: root.msg.outgoing ? Tokens.meta-on-bubble-out : Tokens.text-muted;
                    vertical-alignment: center;
                }
                if root.msg.outgoing: VerticalLayout {
                    alignment: center;
                    DeliveryMark { status: root.msg.status; }
                }
            }
        }
    }
}

component ContactItem inherits Rectangle {
    in property <ContactRow> item;
    in property <bool> selected;
    callback clicked();
    height: 72px;
    background: root.selected ? Tokens.bubble-in : touch.has-hover ? Tokens.surface : transparent;
    border-radius: Tokens.radius-control;
    accessible-role: list-item;
    accessible-label: root.item.name + (root.item.unread > 0 ? ", " + root.item.unread + " unread" : "") + ", " + root.item.preview;
    accessible-action-default => { clicked(); }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: Tokens.space-sm;
        padding-right: Tokens.space-sm;
        spacing: Tokens.space-sm;
        VerticalLayout {
            alignment: center;
            Avatar { initials: root.item.initials; tint: root.item.tint; size: 44px; }
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: Tokens.space-xs;
                Text {
                    text: root.item.name;
                    font-size: Tokens.type-body;
                    font-weight: root.item.unread > 0 ? 600 : 400;
                    color: Tokens.text;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.verified: VerticalLayout {
                    alignment: center;
                    Seal { state: SealState.checked; size: 16px; }
                }
                Caption { text: root.item.time; vertical-alignment: center; }
            }
            HorizontalLayout {
                spacing: Tokens.space-s;
                Text {
                    text: root.item.state == 1 ? "Wants to talk" : root.item.state == 0 ? "Waiting for them to accept" : root.item.preview;
                    font-size: Tokens.type-secondary;
                    color: Tokens.text-muted;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                if root.item.unread > 0: Rectangle {
                    min-width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    background: Tokens.pine;
                    Text {
                        text: root.item.unread;
                        font-size: Tokens.type-caption;
                        font-weight: 600;
                        color: Tokens.on-pine;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> filled: false;
    callback clicked();
    width: Tokens.space-touch-target-min;
    height: Tokens.space-touch-target-min;
    border-radius: root.filled ? self.width / 2 : Tokens.radius-control;
    background: root.filled ? (touch.pressed ? Tokens.pine.darker(20%) : Tokens.pine) : (touch.has-hover ? Tokens.bubble-in : transparent);
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Path {
        width: 24px;
        height: 24px;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.icon;
        stroke: root.filled ? Tokens.on-pine : Tokens.pine;
        stroke-width: 1.75px;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        key-pressed(e) => {
            if e.text == " " || e.text == "\n" { root.clicked(); return accept; }
            reject
        }
    }
    if focus.has-focus: Rectangle {
        border-radius: parent.border-radius;
        border-width: Tokens.icon-focus-ring-width;
        border-color: Tokens.focus-ring;
    }
}

component SheetFrame inherits Rectangle {
    in property <string> title;
    in property <length> max-card-width: 520px;
    callback close();
    background: #0000008c;
    accessible-role: groupbox;
    accessible-label: root.title;
    TouchArea { clicked => { root.close(); } }
    card := Rectangle {
        width: min(root.width - 2 * Tokens.space-m, root.max-card-width);
        height: min(root.height - 2 * Tokens.space-m, inner.preferred-height);
        background: Tokens.surface;
        border-radius: Tokens.radius-sheet;
        TouchArea { }
        inner := VerticalLayout {
            padding: Tokens.space-l;
            spacing: Tokens.space-m;
            HorizontalLayout {
                spacing: Tokens.space-s;
                Title { text: root.title; vertical-alignment: center; horizontal-stretch: 1; }
                IconButton { icon: Icons.close; label: "Close"; clicked => { root.close(); } }
            }
            @children
        }
    }
}

export component AppWindow inherits Window {
    title: "Enclave";
    preferred-width: 1180px;
    preferred-height: 780px;
    min-width: 360px;
    min-height: 560px;
    background: Tokens.background;
    default-font-family: "Atkinson Hyperlegible Next";
    default-font-size: Tokens.type-body;

    in-out property <Screen> screen: Screen.welcome;
    in-out property <Sheet> sheet: Sheet.none;
    in property <string> my-name;
    in property <string> my-initials;
    in property <color> my-tint: Tokens.pine;
    in property <[ContactRow]> contacts;
    in property <[ContactRow]> requests;
    in property <[MessageRow]> messages;
    in-out property <string> current-id;
    in property <ContactRow> current;
    in property <string> my-link;
    in property <image> my-qr;
    in property <[string]> code-groups;
    in property <string> add-error;
    in property <string> my-username;
    in property <bool> usernames;
    in property <string> username-error;
    in-out property <string> username-input;
    in property <bool> busy;
    in property <string> status-line;
    in property <bool> show-delivery-hint: true;
    in-out property <int> privacy: 0;
    in property <[string]> recovery-words;
    in property <[PickRow]> pick;
    in property <[DeviceRow]> devices;
    in property <[string]> link-choices;
    in property <string> link-status;
    in property <bool> can-link;
    in-out property <string> group-name;
    in-out property <string> link-code;
    in property <bool> recovery-saved;
    in-out property <string> draft;
    in-out property <string> add-link;
    in-out property <string> add-text;
    in-out property <string> name-input;

    callback get-started();
    callback create-account(string);
    callback select(string);
    callback send(string, string);
    callback accept(string);
    callback decline(string);
    callback add-contact(string, string);
    callback claim-username(string);
    callback remove-device(string);
    callback send-history(string);
    callback start-join();
    callback sheet-changed(Sheet);
    changed sheet => { root.sheet-changed(root.sheet); }
    callback cancel-join();
    in property <bool> can-join;
    in property <string> join-code;
    in property <image> join-qr;
    in property <string> join-words;
    in property <string> recovery-alert;
    in property <string> username-problem;
    in property <string> kt-split;
    callback stop-recovery();
    callback meet-scan(string);
    callback search(string);
    callback add-members(string);
    callback unlock(string);
    callback lock-now();
    callback set-passphrase(string);
    callback new-invite();
    callback cancel-invites();
    in property <int> invites;
    in property <string> unlock-error;
    in property <bool> can-lock;
    in-out property <string> passphrase-input;
    in-out property <string> new-passphrase;
    callback remove-member(string, string);
    callback leave-group(string);
    in property <[ContactRow]> members;
    in property <[PickRow]> addable;
    in property <bool> group-admin;
    in-out property <string> confirm-leave;
    in property <[ContactRow]> search-results;
    in-out property <string> search-query;
    callback react(string, string, string);
    callback edit-message(string, string, string);
    callback delete-message(string, string);
    callback set-timer(string, int);
    callback send-file(string, string, string);
    callback save-file(string, string);
    in property <int> timer;
    in-out property <string> selected-seq;
    in-out property <string> editing-seq;
    in-out property <string> attach-path;
    in-out property <string> attach-caption;
    in-out property <string> attach-error;
    in-out property <string> file-note;
    callback meet-confirm();
    in property <string> meet-code;
    in property <image> meet-qr;
    in property <string> meet-words;
    in property <string> meet-name;
    in property <string> meet-error;
    in property <string> meet-done;
    in-out property <string> meet-input;
    callback approve-recovery();
    in-out property <string> confirm-remove;
    callback mark-checked(string);
    callback copy-text(string);
    callback set-privacy(int);
    callback open-sheet(Sheet);
    callback words-saved();
    callback toggle-pick(string);
    callback create-group(string);
    callback link-scan(string);
    callback link-pick(int);

    property <bool> wide: root.width >= 760px;
    property <bool> has-current: root.current-id != "";

    // ---------------------------------------------------------------- welcome
    if root.screen == Screen.welcome: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-l;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 64px; } }
                VerticalLayout {
                    spacing: Tokens.space-s;
                    Text {
                        text: "Talk privately.";
                        font-size: Tokens.type-onboarding;
                        font-weight: 600;
                        color: Tokens.text;
                        wrap: word-wrap;
                    }
                    Body { text: "No phone number. No email. Only the people you choose can reach you."; color: Tokens.text-muted; }
                }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    PrimaryButton { text: "Get started"; clicked => { root.get-started(); } }
                    if root.can-join: QuietButton { text: "I already have Enclave"; clicked => { root.start-join(); } }
                }
            }
        }
    }

    // ------------------------------------------------------------------- name
    if root.screen == Screen.name: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: "What should people call you?"; }
                name-field := Field {
                    placeholder: "Your name";
                    text <=> root.name-input;
                    accepted => { if root.name-input != "" { root.create-account(root.name-input); } }
                    init => { self.focus(); }
                }
                Secondary { text: "Only people you talk to can see this."; }
                if root.can-join: Field {
                    placeholder: "Passphrase for this computer (optional)";
                    secret: true;
                    text <=> root.new-passphrase;
                }
                if root.can-join && root.new-passphrase != "": Secondary {
                    text: "You'll type it each time Enclave starts. Nobody can reset it; if you forget it, your recovery words bring your account back.";
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: "Continue";
                        enabled: root.name-input != "";
                        clicked => { root.create-account(root.name-input); }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- locked
    if root.screen == Screen.locked: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                HorizontalLayout { alignment: start; Seal { state: SealState.checked; size: 48px; } }
                ScreenTitle { text: "Enclave is locked"; }
                Secondary { text: "Type your passphrase to open your messages on this computer."; }
                unlock-field := Field {
                    placeholder: "Passphrase";
                    secret: true;
                    text <=> root.passphrase-input;
                    accepted => { if root.passphrase-input != "" { root.unlock(root.passphrase-input); root.passphrase-input = ""; } }
                    init => { self.focus(); }
                }
                if root.unlock-error != "": Text {
                    text: root.unlock-error;
                    color: Tokens.danger;
                    font-size: Tokens.type-secondary;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    alignment: start;
                    PrimaryButton {
                        text: root.busy ? "Opening…" : "Unlock";
                        enabled: root.passphrase-input != "" && !root.busy;
                        clicked => { root.unlock(root.passphrase-input); root.passphrase-input = ""; }
                    }
                }
            }
        }
    }

    // ------------------------------------------------------------- setting up
    if root.screen == Screen.setting-up: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        spacing: Tokens.space-m;
        HorizontalLayout { alignment: center; Seal { size: 48px; } }
        Body { text: "Setting up your private address…"; horizontal-alignment: center; }
        Secondary { text: root.status-line; horizontal-alignment: center; }
    }

    // ------------------------------------------------------ link this device
    if root.screen == Screen.join: VerticalLayout {
        alignment: center;
        padding: Tokens.space-l;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: min(440px, root.width - 2 * Tokens.space-l);
                spacing: Tokens.space-m;
                ScreenTitle { text: root.join-words == "" ? "Link this device" : "Pick these words"; }
                Secondary {
                    text: root.join-words == ""
                        ? "On the device you already use, open Settings → Your devices and paste this code. Only use it with your own account."
                        : "Your other device now shows four sets of words. Pick the set that matches these.";
                }
                if root.join-words == "" && root.join-code != "": HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 216px;
                        height: 216px;
                        background: #ffffff;
                        border-radius: Tokens.radius-control;
                        Image {
                            width: 200px;
                            height: 200px;
                            source: root.join-qr;
                            image-rendering: pixelated;
                            accessible-role: image;
                            accessible-label: "QR code of this device's link code";
                        }
                    }
                }
                if root.join-words == "" && root.join-code != "": Text {
                    text: root.join-code;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-caption;
                    color: Tokens.text-muted;
                    overflow: elide;
                }
                if root.join-words != "": Code {
                    text: root.join-words;
                    wrap: word-wrap;
                    accessible-label: "Words: " + root.join-words;
                }
                if root.status-line != "": Secondary { text: root.status-line; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Tokens.space-s;
                    if root.join-words == "" && root.join-code != "": PrimaryButton { text: "Copy code"; clicked => { root.copy-text(root.join-code); } }
                    QuietButton { text: "Cancel"; clicked => { root.cancel-join(); } }
                }
            }
        }
    }

    // ------------------------------------------------------------------- main
    if root.screen == Screen.main: HorizontalLayout {
        // Conversation list.
        if root.wide || !root.has-current: Rectangle {
            width: root.wide ? 320px : root.width;
            background: Tokens.background;
            VerticalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    spacing: Tokens.space-sm;
                    Avatar { initials: root.my-initials; tint: root.my-tint; size: 36px; }
                    Title { text: root.my-name; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                    IconButton {
                        icon: Icons.settings;
                        label: "Settings";
                        clicked => { root.open-sheet(Sheet.settings); }
                    }
                }
                HorizontalLayout {
                    spacing: Tokens.space-s;
                    vertical-stretch: 0;
                    ActionTile { text: "My code"; icon: Icons.qr; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.my-code); } }
                    ActionTile { text: "Add"; icon: Icons.link; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.add); } }
                    ActionTile { text: "Group"; icon: Icons.group; horizontal-stretch: 1; clicked => { root.open-sheet(Sheet.new-group); } }
                }
                if root.recovery-alert != "": Notice {
                    title: "Someone is setting up your account on another device";
                    text: "They used your recovery words. If this isn't you, stop it now. Otherwise your contacts will accept that device on " + root.recovery-alert + ".";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: "Stop it";
                            danger: true;
                            enabled: !root.busy;
                            clicked => { root.stop-recovery(); }
                        }
                        QuietButton { text: "It's me"; clicked => { root.approve-recovery(); } }
                    }
                }
                if root.kt-split != "": Notice {
                    title: "A username server showed people different lists";
                    text: root.kt-split + " gave you and one of your contacts two different signed versions of its public list of usernames. Someone may be trying to send you, or them, to the wrong person. Check security codes, ideally in person, before sharing anything private.";
                    kind: 2;
                }
                if root.username-problem != "": Notice {
                    title: "Your username no longer leads to you";
                    text: "The server's public log now shows " + root.username-problem + " pointing to someone else, or to no one. Your server may have changed it. Tell your contacts to use your code or invite link, and check security codes before sharing anything private.";
                    kind: 2;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Choose a new username"; clicked => { root.open-sheet(Sheet.settings); } }
                    }
                }
                if !root.recovery-saved: Notice {
                    title: "Save your recovery words";
                    text: "They bring your account back if you lose this device.";
                    kind: 0;
                    HorizontalLayout {
                        alignment: start;
                        QuietButton { text: "Show words"; clicked => { root.open-sheet(Sheet.recovery); } }
                    }
                }
                Field {
                    placeholder: "Search messages";
                    text <=> root.search-query;
                    edited => { root.search(root.search-query); }
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.search-query != "": Caption {
                            text: root.search-results.length == 0
                                ? (root.search-query.character-count < 2 ? "Keep typing…" : "No messages found. Search only looks on this device.")
                                : "Messages";
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query != "": VerticalLayout {
                            spacing: 2px;
                            for h in root.search-results: ContactItem {
                                item: h;
                                selected: false;
                                clicked => { root.select(h.id); }
                            }
                        }
                        if root.search-query == "" && root.requests.length > 0: Caption {
                            text: "Message requests";
                            font-weight: 600;
                            height: 28px;
                            vertical-alignment: center;
                        }
                        if root.search-query == "": VerticalLayout {
                            spacing: 2px;
                            for r in root.requests: ContactItem {
                                item: r;
                                selected: r.id == root.current-id;
                                clicked => { root.select(r.id); }
                            }
                            if root.requests.length > 0 && root.contacts.length > 0: Caption {
                                text: "Conversations";
                                font-weight: 600;
                                height: 28px;
                                vertical-alignment: center;
                            }
                            for c in root.contacts: ContactItem {
                                item: c;
                                selected: c.id == root.current-id;
                                clicked => { root.select(c.id); }
                            }
                        }
                    }
                }
                Caption { text: root.status-line; wrap: word-wrap; }
            }
        }
        if root.wide: Rectangle { width: 1px; background: Tokens.hairline; }

        // Conversation.
        if root.wide || root.has-current: Rectangle {
            horizontal-stretch: 1;
            background: Tokens.background;

            if !root.has-current: VerticalLayout {
                alignment: center;
                padding: Tokens.space-xl;
                spacing: Tokens.space-m;
                HorizontalLayout {
                    alignment: center;
                    VerticalLayout {
                        width: min(420px, parent.width - 2 * Tokens.space-xl);
                        spacing: Tokens.space-m;
                        Title { text: root.contacts.length + root.requests.length == 0 ? "Start your first conversation" : "Choose a conversation"; }
                        Secondary {
                            text: "Show your code to someone next to you, or send them your invite link. Meeting in person is the strongest way to check it's really them.";
                        }
                    }
                }
            }

            if root.has-current: VerticalLayout {
                // Header.
                Rectangle {
                    height: 72px;
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        spacing: Tokens.space-sm;
                        if !root.wide: VerticalLayout {
                            alignment: center;
                            IconButton { icon: Icons.back; label: "Back"; clicked => { root.current-id = ""; } }
                        }
                        VerticalLayout {
                            alignment: center;
                            Avatar { initials: root.current.initials; tint: root.current.tint; size: 40px; }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Title { text: root.current.name; overflow: elide; wrap: no-wrap; }
                            HorizontalLayout {
                                spacing: Tokens.space-xs;
                                if root.current.kind == 0: Seal { state: root.current.verified ? SealState.checked : SealState.unchecked; size: 16px; }
                                Caption {
                                    text: root.current.kind == 1
                                        ? root.current.members + " people · Off the record"
                                        : (root.current.met ? "Met in person" : root.current.verified ? "Checked" : "Not checked yet") + " · Off the record";
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        if root.current.kind == 1: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: "Members";
                                clicked => { root.open-sheet(Sheet.members); }
                            }
                        }
                        if root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            IconButton {
                                icon: Icons.timer;
                                label: root.timer > 0 ? "Disappearing messages: on" : "Disappearing messages: off";
                                clicked => { root.open-sheet(Sheet.timer); }
                            }
                        }
                        if root.current.state == 2 && root.current.kind == 0: VerticalLayout {
                            alignment: center;
                            QuietButton {
                                text: !root.wide ? "Code" : root.current.verified ? "Security code" : "Check code";
                                clicked => { root.open-sheet(Sheet.check-code); }
                            }
                        }
                    }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.hairline; }
                }

                // Messages.
                Flickable {
                    vertical-stretch: 1;
                    content-height: max(self.height, thread.preferred-height);
                    content-y: min(0px, self.height - self.content-height);
                    thread := VerticalLayout {
                        alignment: end;
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.show-delivery-hint && root.current.state == 2: Caption {
                            text: "Private delivery takes a few seconds. That pause is part of what hides who you talk to.";
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        for m in root.messages: Bubble {
                            msg: m;
                            bubble-max: min(480px, root.width * 0.7);
                            selected: root.selected-seq == m.seq;
                            tapped => {
                                if root.current.state == 2 && root.current.kind == 0 && !m.deleted {
                                    root.selected-seq = root.selected-seq == m.seq ? "" : m.seq;
                                }
                            }
                        }
                    }
                }

                // Request, pending or composer.
                if root.current.state == 1: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: root.current.name + " wants to talk";
                            text: "You haven't talked before. They can't see whether you've read this until you accept. The name is what they typed; check their security code before sharing anything private.";
                            HorizontalLayout {
                                spacing: Tokens.space-s;
                                alignment: start;
                                PrimaryButton { text: "Accept"; clicked => { root.accept(root.current-id); } }
                                QuietButton { text: "Delete"; danger: true; clicked => { root.decline(root.current-id); } }
                            }
                        }
                    }
                }
                if root.current.state == 0: Rectangle {
                    VerticalLayout {
                        padding: Tokens.space-m;
                        Notice {
                            title: "Waiting for " + root.current.name + " to accept";
                            text: "You can write again once they accept your request.";
                        }
                    }
                }
                // Actions on the selected message.
                if root.current.state == 2 && root.selected-seq != "": Rectangle {
                    background: Tokens.surface;
                    Rectangle { y: 0; height: 1px; background: Tokens.hairline; }
                    HorizontalLayout {
                        padding-left: Tokens.space-m;
                        padding-right: Tokens.space-m;
                        padding-top: Tokens.space-s;
                        spacing: Tokens.space-xs;
                        for e in ["👍", "❤", "😂", "😮", "😢", "🙏"]: Rectangle {
                            width: Tokens.space-touch-target-min;
                            height: Tokens.space-touch-target-min;
                            border-radius: Tokens.radius-control;
                            background: react-touch.has-hover ? Tokens.bubble-in : transparent;
                            accessible-role: button;
                            accessible-label: "React " + e;
                            accessible-action-default => {
                                root.react(root.current-id, root.selected-seq, e);
                                root.selected-seq = "";
                            }
                            Text {
                                text: e;
                                font-size: 24px;
                                color: Tokens.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            react-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.react(root.current-id, root.selected-seq, e);
                                    root.selected-seq = "";
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        for m in root.messages: HorizontalLayout {
                            spacing: Tokens.space-xs;
                            if m.seq == root.selected-seq && m.can-edit: QuietButton {
                                text: "Edit";
                                clicked => {
                                    root.editing-seq = m.seq;
                                    root.draft = m.text;
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.outgoing && !m.deleted: QuietButton {
                                text: "Delete";
                                danger: true;
                                accessible-label: "Delete for everyone";
                                clicked => {
                                    root.delete-message(root.current-id, m.seq);
                                    root.selected-seq = "";
                                }
                            }
                            if m.seq == root.selected-seq && m.file != "": QuietButton {
                                text: "Save";
                                accessible-label: "Save " + m.file;
                                clicked => {
                                    root.save-file(root.current-id, m.seq);
                                    root.selected-seq = "";
                                }
                            }
                        }
                    }
                }
                if root.current.state == 2 && root.file-note != "": Caption {
                    text: root.file-note;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.current.state == 2: Rectangle {
                    HorizontalLayout {
                        padding: Tokens.space-m;
                        spacing: Tokens.space-s;
                        if root.current.kind == 0 && root.editing-seq == "": IconButton {
                            icon: Icons.attach;
                            label: "Send a file";
                            clicked => { root.attach-error = ""; root.open-sheet(Sheet.attach); }
                        }
                        composer := Field {
                            placeholder: root.editing-seq != "" ? "Edit your message" : "Message";
                            text <=> root.draft;
                            horizontal-stretch: 1;
                            accepted => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        root.send(root.current-id, root.draft);
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                        if root.editing-seq != "": QuietButton {
                            text: "Cancel";
                            clicked => { root.editing-seq = ""; root.draft = ""; }
                        }
                        IconButton {
                            icon: Icons.send;
                            label: root.editing-seq != "" ? "Save edit" : "Send";
                            filled: true;
                            clicked => {
                                if root.draft != "" {
                                    if root.editing-seq != "" {
                                        root.edit-message(root.current-id, root.editing-seq, root.draft);
                                        root.editing-seq = "";
                                    } else {
                                        root.send(root.current-id, root.draft);
                                    }
                                    root.draft = "";
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ----------------------------------------------------------------- sheets
    if root.sheet == Sheet.my-code: SheetFrame {
        title: "Your code";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Let someone next to you scan this. For someone who isn't here, copy an invite link: each one works for one person, for 7 days. Either way, they can then send you a message request."; }
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 248px;
                height: 248px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 232px;
                    height: 232px;
                    source: root.my-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: "QR code of your contact code";
                }
            }
        }
        if root.my-username != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Secondary { text: "Or they can look you up as"; vertical-alignment: center; horizontal-stretch: 0; }
            Text {
                text: root.my-username;
                font-family: "Atkinson Hyperlegible Mono";
                font-size: Tokens.type-secondary;
                color: Tokens.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: "Copy invite link"; enabled: !root.busy; clicked => { root.new-invite(); } }
            if root.my-username != "": QuietButton { text: "Copy username"; clicked => { root.copy-text(root.my-username); } }
        }
        if root.invites > 0: HorizontalLayout {
            spacing: Tokens.space-s;
            Caption {
                text: root.invites == 1 ? "1 invite link hasn't been used yet." : root.invites + " invite links haven't been used yet.";
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            QuietButton { text: "Cancel them"; horizontal-stretch: 0; clicked => { root.cancel-invites(); } }
        }
    }

    if root.sheet == Sheet.add: SheetFrame {
        title: "Add someone";
        close => { root.sheet = Sheet.none; }
        Secondary { text: root.usernames ? "Paste the invite link they sent you, or type their username." : "Paste the invite link they sent you."; }
        Field { placeholder: root.usernames ? "enclave:add#…  or  @name@server" : "enclave:add#…"; mono: true; text <=> root.add-link; }
        Field { placeholder: "Say hello (optional)"; text <=> root.add-text; }
        if root.add-error != "": HorizontalLayout {
            spacing: Tokens.space-s;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                background: Tokens.danger;
                Text { text: "!"; color: Tokens.surface; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
            }
            Text { text: "Couldn't add them"; color: Tokens.danger; font-size: Tokens.type-body; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
        }
        if root.add-error != "": Text {
            text: root.add-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? "Sending request…" : "Send request";
                enabled: root.add-link != "" && !root.busy;
                clicked => { root.add-contact(root.add-link, root.add-text); }
            }
        }
        HorizontalLayout {
            alignment: start;
            QuietButton { text: "Together right now? Meet in person"; outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.timer: SheetFrame {
        title: "Disappearing messages";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "New messages in this conversation disappear from both phones this long after they're read. Anyone can still take a screenshot."; }
        for option in [
            { label: "Off", secs: 0 },
            { label: "5 minutes", secs: 300 },
            { label: "1 hour", secs: 3600 },
            { label: "1 day", secs: 86400 },
            { label: "1 week", secs: 604800 },
        ]: Rectangle {
            height: Tokens.space-touch-target-min;
            border-radius: Tokens.radius-control;
            border-width: root.timer == option.secs ? 2px : 1px;
            border-color: root.timer == option.secs ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.timer == option.secs;
            accessible-label: option.label;
            accessible-action-default => { root.set-timer(root.current-id, option.secs); }
            TouchArea { clicked => { root.set-timer(root.current-id, option.secs); } }
            HorizontalLayout {
                padding-left: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.timer == option.secs ? Tokens.pine : Tokens.text-muted;
                        if root.timer == option.secs: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                Body { text: option.label; vertical-alignment: center; }
            }
        }
    }

    if root.sheet == Sheet.attach: SheetFrame {
        title: "Send a file";
        close => { root.sheet = Sheet.none; }
        Secondary { text: "Files are sealed before they leave this device and padded so their size doesn't give them away. " + root.current.name + " downloads them only when they choose to."; }
        Field { placeholder: "Path to the file"; mono: true; text <=> root.attach-path; }
        Field { placeholder: "Add a caption (optional)"; text <=> root.attach-caption; }
        if root.attach-error != "": Text {
            text: root.attach-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Sending…" : "Send";
                enabled: root.attach-path != "" && !root.busy;
                clicked => { root.send-file(root.current-id, root.attach-path, root.attach-caption); }
            }
        }
    }

    if root.sheet == Sheet.meet: SheetFrame {
        title: root.meet-done != "" ? "You and " + root.meet-done + " are checked in person" : root.meet-words != "" ? "Do you both see these words?" : "Meet in person";
        close => { root.sheet = Sheet.none; }
        if root.meet-done != "": HorizontalLayout {
            alignment: start;
            Seal { state: SealState.checked; size: 48px; }
        }
        if root.meet-done != "": Secondary { text: "If anything changes, we'll tell you before you send anything. Your conversation now also rests on a secret that only crossed the room between your two screens."; }
        if root.meet-done != "": HorizontalLayout {
            alignment: start;
            PrimaryButton { text: "Done"; clicked => { root.sheet = Sheet.none; } }
        }

        if root.meet-done == "" && root.meet-words == "": Secondary {
            text: "Show this code to the other person and scan theirs. It only works face to face: codes sent over a message or a call don't count.";
        }
        if root.meet-done == "" && root.meet-words == "" && root.meet-code != "": HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 216px;
                height: 216px;
                background: #ffffff;
                border-radius: Tokens.radius-control;
                Image {
                    width: 200px;
                    height: 200px;
                    source: root.meet-qr;
                    image-rendering: pixelated;
                    accessible-role: image;
                    accessible-label: "Your in-person code";
                }
            }
        }
        if root.meet-done == "" && root.meet-words == "": Field { placeholder: "Their code: enclave:meet#…"; mono: true; text <=> root.meet-input; }
        if root.meet-done == "" && root.meet-words == "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words == "": HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: "Continue";
                enabled: root.meet-input != "";
                clicked => { root.meet-scan(root.meet-input); root.meet-input = ""; }
            }
        }

        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-sm;
            Seal { state: SealState.checked; size: 32px; }
            Code {
                text: root.meet-words;
                vertical-alignment: center;
                accessible-label: "Seal words: " + root.meet-words;
            }
        }
        if root.meet-done == "" && root.meet-words != "": Secondary {
            text: root.meet-name + "'s phone should show the same three words. If it does, you scanned each other and nobody else.";
        }
        if root.meet-done == "" && root.meet-words != "" && root.meet-error != "": Text {
            text: root.meet-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        if root.meet-done == "" && root.meet-words != "": HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton {
                text: root.busy ? "Checking…" : "They match";
                enabled: !root.busy;
                clicked => { root.meet-confirm(); }
            }
            QuietButton { text: "They don't"; clicked => { root.sheet = Sheet.none; } }
        }
    }

    if root.sheet == Sheet.check-code: SheetFrame {
        title: root.current.verified ? "You and " + root.current.name + " are checked" : "Check it's really " + root.current.name;
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: root.current.verified
                ? "If anything changes, we'll tell you before you send anything."
                : "Compare these numbers with " + root.current.name + " in person or on a call. If every group matches, tap They match.";
        }
        HorizontalLayout {
            alignment: center;
            GridLayout {
                spacing-horizontal: Tokens.space-l;
                spacing-vertical: Tokens.space-s;
                for g[i] in root.code-groups: Code {
                    text: g;
                    row: i / 3;
                    col: mod(i, 3);
                    accessible-label: "Group " + (i + 1) + ": " + g;
                }
            }
        }
        if root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            Seal { state: SealState.checked; size: 24px; }
            Body { text: root.current.met ? "Checked in person" : "Checked"; vertical-alignment: center; }
        }
        if !root.current.verified: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            PrimaryButton { text: "They match"; clicked => { root.mark-checked(root.current-id); } }
            QuietButton { text: "Not now"; clicked => { root.sheet = Sheet.none; } }
        }
        if !root.current.met: HorizontalLayout {
            alignment: start;
            QuietButton { text: "Together right now? Meet in person"; outlined: true; clicked => { root.open-sheet(Sheet.meet); } }
        }
    }

    if root.sheet == Sheet.settings: SheetFrame {
        title: "Settings";
        close => { root.sheet = Sheet.none; }
        for option[i] in [
            { title: "Standard", text: "Hides who you talk to. Uses about 60 MB an hour while Enclave is open, and about 40 MB a day in the background." },
            { title: "Maximum", text: "Also hides when you're using Enclave. Uses about 1.5 GB a day. Large files send slowly." },
        ]: Rectangle {
            min-height: row.preferred-height;
            border-radius: Tokens.radius-control;
            border-width: root.privacy == i ? 2px : 1px;
            border-color: root.privacy == i ? Tokens.pine : Tokens.hairline;
            accessible-role: radio-button;
            accessible-checked: root.privacy == i;
            accessible-label: option.title;
            accessible-action-default => { root.set-privacy(i); }
            TouchArea { clicked => { root.set-privacy(i); } }
            row := HorizontalLayout {
                padding: Tokens.space-m;
                spacing: Tokens.space-sm;
                VerticalLayout {
                    alignment: start;
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: root.privacy == i ? Tokens.pine : Tokens.text-muted;
                        if root.privacy == i: Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.pine; }
                    }
                }
                VerticalLayout {
                    spacing: Tokens.space-xs;
                    Body { text: option.title; font-weight: 600; }
                    Secondary { text: option.text; }
                }
            }
        }
        if root.usernames: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.usernames: Body { text: "Username"; font-weight: 600; }
        if root.usernames && root.my-username != "": Text {
            text: root.my-username;
            font-family: "Atkinson Hyperlegible Mono";
            font-size: Tokens.type-body;
            color: Tokens.text;
            accessible-label: "Your username: " + root.my-username;
        }
        if root.usernames: Secondary {
            text: root.my-username == ""
                ? "Optional. A username is public, like an email address: anyone who knows it can send you a message request."
                : "Anyone who knows it can send you a message request. Choosing a new one retires this one.";
        }
        if root.usernames: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: "name"; mono: true; text <=> root.username-input; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? "Checking…" : (root.my-username == "" ? "Choose" : "Change");
                enabled: root.username-input != "" && !root.busy;
                clicked => { root.claim-username(root.username-input); }
            }
        }
        if root.usernames && root.username-error != "": Text {
            text: root.username-error;
            color: Tokens.danger;
            font-size: Tokens.type-secondary;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Tokens.space-s;
            QuietButton {
                text: "Recovery words";
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.recovery); }
            }
            QuietButton {
                text: "Your devices";
                outlined: true;
                horizontal-stretch: 1;
                clicked => { root.open-sheet(Sheet.devices); }
            }
        }
        if root.can-join: Rectangle { height: 1px; background: Tokens.hairline; }
        if root.can-join: Body { text: "Passphrase"; font-weight: 600; }
        if root.can-join: Secondary {
            text: root.can-lock
                ? "Enclave asks for it each time it starts on this computer."
                : "Optional. Enclave would ask for it each time it starts on this computer.";
        }
        if root.can-join: HorizontalLayout {
            spacing: Tokens.space-s;
            Field { placeholder: root.can-lock ? "New passphrase" : "Passphrase"; secret: true; text <=> root.new-passphrase; horizontal-stretch: 1; }
            PrimaryButton {
                text: root.busy ? "Saving…" : (root.can-lock ? "Change" : "Set");
                enabled: root.new-passphrase != "" && !root.busy;
                clicked => { root.set-passphrase(root.new-passphrase); }
            }
        }
        if root.can-lock: HorizontalLayout {
            alignment: start;
            spacing: Tokens.space-s;
            QuietButton { text: "Lock now"; outlined: true; clicked => { root.sheet = Sheet.none; root.lock-now(); } }
            QuietButton { text: "Remove passphrase"; danger: true; clicked => { root.set-passphrase(""); } }
        }
    }

    if root.sheet == Sheet.new-group: SheetFrame {
        title: "New group";
        close => { root.sheet = Sheet.none; }
        Field { placeholder: "Group name"; text <=> root.group-name; }
        Secondary { text: root.pick.length == 0 ? "Add people as contacts first. Groups are made from people who have accepted you." : "Choose who to add. Everyone in the group can see who else is in it."; }
        for p in root.pick: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Creating…" : "Create group";
                enabled: root.group-name != "" && !root.busy;
                clicked => { root.create-group(root.group-name); }
            }
        }
    }

    if root.sheet == Sheet.members: SheetFrame {
        title: root.current.name;
        close => { root.sheet = Sheet.none; root.confirm-leave = ""; }
        Secondary { text: root.current.members + " people, you included. Everyone in the group can see who else is in it."; }
        for m in root.members: HorizontalLayout {
            spacing: Tokens.space-sm;
            height: 56px;
            VerticalLayout { alignment: center; Avatar { initials: m.initials; tint: m.tint; size: 36px; } }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Body { text: m.name; overflow: elide; }
                if m.met || m.verified: Caption { text: m.met ? "Met in person" : "Checked"; }
            }
            if root.group-admin: VerticalLayout {
                alignment: center;
                QuietButton {
                    text: "Remove";
                    danger: true;
                    accessible-label: "Remove " + m.name;
                    clicked => { root.remove-member(root.current-id, m.id); }
                }
            }
        }
        if root.group-admin && root.addable.length > 0: Body { text: "Add people"; font-weight: 600; }
        if root.group-admin && root.addable.length > 0: Secondary { text: "They'll see new messages from now on, not what was said before they joined."; }
        if root.group-admin: VerticalLayout {
        for p in root.addable: Rectangle {
            height: 56px;
            border-radius: Tokens.radius-control;
            background: p.selected ? Tokens.bubble-in : transparent;
            accessible-role: checkbox;
            accessible-checked: p.selected;
            accessible-label: p.name;
            accessible-action-default => { root.toggle-pick(p.id); }
            TouchArea { clicked => { root.toggle-pick(p.id); } }
            HorizontalLayout {
                padding-left: Tokens.space-s;
                padding-right: Tokens.space-s;
                spacing: Tokens.space-sm;
                VerticalLayout { alignment: center; Avatar { initials: p.initials; tint: p.tint; size: 36px; } }
                Body { text: p.name; vertical-alignment: center; horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 22px;
                        height: 22px;
                        border-radius: 4px;
                        border-width: 2px;
                        border-color: p.selected ? Tokens.pine : Tokens.text-muted;
                        background: p.selected ? Tokens.pine : transparent;
                        if p.selected: Path {
                            width: 16px;
                            height: 16px;
                            viewbox-width: 24;
                            viewbox-height: 24;
                            commands: "M 5 12 L 10 17 L 19 7";
                            stroke: Tokens.on-pine;
                            stroke-width: 2.5px;
                        }
                    }
                }
            }
        }
        }
        if root.group-admin && root.addable.length > 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Adding…" : "Add to group";
                enabled: !root.busy;
                clicked => { root.add-members(root.current-id); }
            }
        }
        if root.confirm-leave == "": HorizontalLayout {
            alignment: start;
            QuietButton { text: "Leave group"; danger: true; clicked => { root.confirm-leave = root.current-id; } }
        }
        if root.confirm-leave != "": Notice {
            title: "Leave " + root.current.name + "?";
            text: "You'll stop getting its messages. Someone would have to add you again.";
            kind: 2;
            HorizontalLayout {
                alignment: start;
                spacing: Tokens.space-s;
                PrimaryButton { text: "Leave"; danger: true; clicked => { root.leave-group(root.current-id); root.confirm-leave = ""; } }
                QuietButton { text: "Stay"; clicked => { root.confirm-leave = ""; } }
            }
        }
    }

    if root.sheet == Sheet.devices: SheetFrame {
        title: "Your devices";
        close => { root.sheet = Sheet.none; }
        for d in root.devices: Rectangle {
            min-height: dev.preferred-height;
            dev := VerticalLayout {
            spacing: Tokens.space-s;
            HorizontalLayout {
                spacing: Tokens.space-sm;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Body { text: d.label; font-weight: 600; }
                    Secondary { text: d.detail; }
                }
                if d.removable && root.confirm-remove != d.id: QuietButton {
                    text: "Remove";
                    accessible-label: "Remove " + d.label;
                    clicked => { root.confirm-remove = d.id; }
                }
            }
            if d.history-pending && root.confirm-remove != d.id: HorizontalLayout {
                alignment: start;
                QuietButton {
                    text: "Send history now";
                    outlined: true;
                    accessible-label: "Send message history to " + d.label + " now";
                    clicked => { root.send-history(d.id); }
                }
            }
            if root.confirm-remove == d.id: Rectangle {
                min-height: confirm.preferred-height;
                border-radius: Tokens.radius-control;
                border-width: 1px;
                border-color: Tokens.danger;
                confirm := VerticalLayout {
                    padding: Tokens.space-m;
                    spacing: Tokens.space-s;
                    Body { text: "Remove this device?"; font-weight: 600; }
                    Secondary { text: "It stops getting new messages, and your contacts stop sending to it. Messages already on it stay there until it's erased."; }
                    HorizontalLayout {
                        alignment: start;
                        spacing: Tokens.space-s;
                        PrimaryButton {
                            text: root.busy ? "Removing…" : "Remove device";
                            danger: true;
                            enabled: !root.busy;
                            clicked => { root.remove-device(d.id); }
                        }
                        QuietButton { text: "Keep it"; clicked => { root.confirm-remove = ""; } }
                    }
                }
            }
        }
        }
        if root.can-link && root.link-choices.length == 0: Secondary {
            text: "To link a new device, open Enclave on it, choose \"I already have Enclave\", and paste its link code here. Only do this with your own device.";
        }
        if root.can-link && root.link-choices.length == 0: Field { placeholder: "enclave:link#…"; mono: true; text <=> root.link-code; }
        if root.can-link && root.link-choices.length == 0: HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.busy ? "Checking…" : "Continue";
                enabled: root.link-code != "" && !root.busy;
                clicked => { root.link-scan(root.link-code); }
            }
        }
        if root.link-choices.length > 0: VerticalLayout {
            spacing: Tokens.space-s;
            Body { text: "Which words does your new device show?"; font-weight: 600; }
            for c[i] in root.link-choices: QuietButton {
                text: c;
                outlined: true;
                clicked => { root.link-pick(i); }
            }
        }
        if root.link-status != "": Secondary { text: root.link-status; }
        if !root.can-link: Secondary { text: "Only your first device can link new ones."; }
    }

    if root.sheet == Sheet.recovery: SheetFrame {
        title: "Your recovery words";
        max-card-width: 640px;
        close => { root.sheet = Sheet.none; }
        Secondary {
            text: "If you lose this device, these 24 words bring your account back. Anyone who has them can become you. Write them down on paper and keep them somewhere safe.";
        }
        GridLayout {
            spacing-horizontal: Tokens.space-m;
            spacing-vertical: Tokens.space-xs;
            for w[i] in root.recovery-words: HorizontalLayout {
                row: root.wide ? mod(i, 6) : i / 2;
                col: root.wide ? i / 6 : mod(i, 2);
                spacing: Tokens.space-s;
                Caption { text: i + 1; width: 20px; horizontal-alignment: right; vertical-alignment: center; }
                Text {
                    text: w;
                    font-family: "Atkinson Hyperlegible Mono";
                    font-size: Tokens.type-body;
                    color: Tokens.text;
                }
            }
        }
        HorizontalLayout {
            alignment: start;
            PrimaryButton {
                text: root.recovery-saved ? "Done" : "I've written them down";
                clicked => { root.words-saved(); root.sheet = Sheet.none; }
            }
        }
    }
}
