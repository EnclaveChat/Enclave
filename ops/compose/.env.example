# One operator's stack (compose.yml). Copy to .env and fill in.

# Image and version (a release tag, or a digest-pinned reference).
ENCLAVE_IMAGE=ghcr.io/enclavechat/enclave-server
ENCLAVE_VERSION=latest

# This stack's public domain: the front serves it, the server's descriptor
# and usernames (@name@DOMAIN) carry it.
DOMAIN=enclave.example.org
# Shown to users; one name per organization.
OPERATOR=Example Org
# Servers, witnesses and relays of one family never count as independent.
FAMILY=example-org

# Certificates for the front: acme (Let's Encrypt), files or self-signed.
TLS_MODE=acme
ACME_EMAIL=ops@example.org

# The call relay's public address (IP:port reachable over UDP).
RELAY_PUBLIC_ADDR=203.0.113.10:51820

# Published ports (defaults 80, 443, 51820).
# FRONT_HTTP_PORT=80
# FRONT_HTTPS_PORT=443
# RELAY_PORT=51820
