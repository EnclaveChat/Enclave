# enclave-front (docs/12-servers.md §4.5). DOMAIN, TLS_MODE and ACME_EMAIL
# come from .env (ENCLAVE_FRONT__* in compose.yml).

[front]
listen_https = "0.0.0.0:443"
listen_http = "0.0.0.0:80"
public_dir = "/var/lib/enclave/public"
# The stack's witness, proxied at /witness/v1/.
witness = "http://witness:7446"
data_dir = "/var/lib/enclave/front"
# tls = "acme"          # or "files" (with cert and key) or "self-signed"
# acme_directory = "https://acme-v02.api.letsencrypt.org/directory"
# cert = "/etc/enclave/tls/fullchain.pem"
# key = "/etc/enclave/tls/privkey.pem"
